# Copy to .env and replace development passwords before running.
POSTGRES_ADMIN_PASSWORD=postgres_dev_only
POSTGRES_USER=pipeline_user
POSTGRES_PASSWORD=pipeline_dev_only
AIRFLOW_USER=airflow
AIRFLOW_PASSWORD=airflow_dev_only
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# OpenSky OAuth2 client credentials (optional for API access, recommended).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Bounding box for OpenSky states/all API (degrees).
# Keep the queried area within OpenSky's applicable credit limits.
BBOX_LAMIN=24.0
BBOX_LAMAX=28.0
BBOX_LOMIN=66.0
BBOX_LOMAX=70.0

# Local script connection settings (host machine).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=flights_dw
