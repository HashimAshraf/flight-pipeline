# Copy this file to .env and fill in real values. Never commit .env.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=flights_dw
POSTGRES_USER=pipeline_user
POSTGRES_PASSWORD=change_me

# OpenSky OAuth2 API client (from your OpenSky account page)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Bounding box (keep area <= 25 square degrees for a 1-credit query)
BBOX_LAMIN=24.0
BBOX_LAMAX=28.0
BBOX_LOMIN=66.0
BBOX_LOMAX=70.0
